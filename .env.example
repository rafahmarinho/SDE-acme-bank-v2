# ACME Bank - example environment variables (copy to .env.local; NEVER commit real values)
# Public (exposed to the browser) - the anon key is safe only because RLS is enforced on every table.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only - never prefix with NEXT_PUBLIC_ and never import from client components.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Used for HMAC-signed transfer quotes.
APP_SIGNING_KEY=<base64-32-bytes>
# 32 random bytes, base64. Used for AES-256-GCM field encryption.
APP_ENCRYPTION_KEY=<base64-32-bytes>
# Shared secret sent by Vercel Cron to /api/jobs/* (at least 32 random characters).
CRON_SECRET=<random-32+-chars>

# Simulation controls (scenario picker / advance / reset). Disabled unless explicitly enabled.
SIMULATION_ADMIN_ENABLED=false

# Demo seeding only (scripts/seed-demo.ts). Generate a different value per environment.
DEMO_USER_PASSWORD=<generate-per-environment>
